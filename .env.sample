# Copy to .env and fill in. .env is git-ignored — never commit it.

# BSC Testnet RPC endpoint (chain 97), e.g.
#   https://bsc-testnet.nodereal.io/v1/<your NodeReal API key>
#   https://bsc-testnet-rpc.publicnode.com   (free, no key, less reliable)
RPC_URL=

# The token owner's wallet: the only address that can mint. An encrypted JSON
# keystore (as made by ethers / MetaMask export / geth) and a text file holding
# its password. Absolute, ~/ or project-relative paths. The owner needs some
# tBNB for gas (https://www.bnbchain.org/en/testnet-faucet).
OWNER_KEYSTORE=
OWNER_KEYSTORE_PASSWORD_FILE=
